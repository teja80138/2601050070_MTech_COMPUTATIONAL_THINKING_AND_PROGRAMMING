      "source": [
        "# Inventory Item Using Dataclass\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from dataclasses import dataclass\n",
        "\n",
        "@dataclass\n",
        "class InventoryItem:\n",
        "    product_id: int\n",
        "    product_name: str\n",
        "    quantity: int\n",
        "    price: float\n",
        "\n",
        "\n",
        "item = InventoryItem(101, \"Laptop\", 25, 55000.0)\n",
        "\n",
        "print(item)\n"
      ]
    }
  ],
